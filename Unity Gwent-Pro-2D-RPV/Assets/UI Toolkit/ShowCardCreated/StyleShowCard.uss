VisualElement {
}

.Container {
    background-image: url('project://database/Assets/Images/photo_1_2024-09-11_05-03-50.jpg?fileID=21300000&guid=01f7ae132cbfec447af671d008eb1a15&type=3#photo_1_2024-09-11_05-03-50');
    cursor: initial;
}

.Up {
    height: 20%;
    cursor: initial;
}

.Center {
    height: 60%;
    width: 80%;
    align-self: center;
    justify-content: space-between;
    align-items: stretch;
    flex-direction: column;
    overflow: hidden;
    flex-shrink: 0;
    cursor: initial;
}

.Down {
    height: 20%;
    align-items: auto;
    justify-content: space-around;
    align-self: flex-start;
    cursor: initial;
}

.ButtonOk {
    width: 100%;
    height: 30%;
    -unity-font-style: bold-and-italic;
    color: rgb(36, 171, 255);
    -unity-text-align: middle-center;
    font-size: 30px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(3, 63, 145);
    transition-timing-function: ease-in-out;
    transition-duration: 0.2s;
    opacity: 0.84;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    left: 70%;
    cursor: initial;
}

.ButtonOk:hover {
    scale: 1.2 1.2;
    opacity: 0.96;
}

.ButtonOk:active {
    scale: 1.1 1.1;
    opacity: 0.9;
}

.Box {
    width: 90%;
    align-self: center;
    align-items: stretch;
    justify-content: space-evenly;
    height: 60%;
    max-height: 80%;
    flex-direction: row;
    cursor: initial;
}
