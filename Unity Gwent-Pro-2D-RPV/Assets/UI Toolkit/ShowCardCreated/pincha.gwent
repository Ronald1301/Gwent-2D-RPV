        effect{ 
                Name :"Damage",
                Params: { 
                         amount: Number
                        }, 
                Action: (targets, context) =>
                        {
                            for target in targets
                            {
                                i = 0;
                                while (i++ < amount) target.Power -= 1;
                            };
                        }
                }

        effect {
                 Name: "Draw",
                 Action: (targets, context) =>
                    {
                        topCard = context.Deck.Pop();
                        context.Hand.Add(topCard);
                        context.Hand.Shuffle();
                    }
                }

        effect {
                 Name: "Return" @@ "ToDeck",
                 Action: (targets, context) =>
                    {
                        for target in targets
                        {
                            owner = target.Owner;
                            deck = context.DeckOfPlayer(owner);
                            deck.Push(target);
                            deck.Shuffle();
                            context.Board.Remove(target);
                        };
                    }
                }
 
        card { 
               Type: "Silver",
                Name: "Cyclops",
               Faction: "Resistance",
                Power: 4,
                Range: ["Ranged"],
               OnActivation: [ ]
            }

       card { 
            Type: "Oro",
            Name: "Beluga", 
            Faction: "Pira" @ "tes",
            Power: 10,
            Range: ["Melee", "Ranged"],
            OnActivation:
                        [
                            {
                                Effect:
                                         {
                                            Name: "Damage",
                                            amount: 5
                                         } , 
                                 Selector:
                                        {
                                            Source: "board",
                                            Single: false, 
                                            Predicate: (unit) => unit.Faction == "Pirates"
                                          } ,
                                PostAction:
                                        {
                                            Type: "Return ToDeck", 
                                            Selector:
                                                    {
                                                        Source: "parent", 
                                                         Single: false,
                                                         Predicate: (unit) => unit.Power < 1
                                                      }
                                            }   
                                }, 
                            {
                                Effect: "Draw"
                            } 
                        ] 
            }

            card { 
               Type: "Silver",
                Name: "Geralt",
               Faction: "Resistance",
                Power: 2,
                Range: ["Siege"],
               OnActivation: [ ]
            } 
